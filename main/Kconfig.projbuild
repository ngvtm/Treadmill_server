menu "Example Configuration"

    choice EXAMPLE_USE_IO_TYPE
        prompt "I/O Capability"
        default BLE_SM_IO_CAP_NO_IO
        help
            I/O capability of device.

        config BLE_SM_IO_CAP_DISP_ONLY
            bool "DISPLAY ONLY"
        config BLE_SM_IO_CAP_DISP_YES_NO
            bool "DISPLAY YESNO"
        config BLE_SM_IO_CAP_KEYBOARD_ONLY
            bool "KEYBOARD ONLY"
        config BLE_SM_IO_CAP_NO_IO
            bool "Just works"
        config BLE_SM_IO_CAP_KEYBOARD_DISP
            bool "Both KEYBOARD & DISPLAY"
    endchoice

    config EXAMPLE_IO_TYPE
        int
        default 0 if BLE_SM_IO_CAP_DISP_ONLY
        default 1 if BLE_SM_IO_CAP_DISP_YES_NO
        default 2 if BLE_SM_IO_CAP_KEYBOARD_ONLY
        default 3 if BLE_SM_IO_CAP_NO_IO
        default 4 if BLE_SM_IO_CAP_KEYBOARD_DISP

    config EXAMPLE_BONDING
        bool
        default n
        prompt "Use Bonding"
        help
            Use this option to enable/disable bonding.

    config EXAMPLE_MITM
        bool
        default n
        prompt "MITM security"
        help
            Use this option to enable/disable MITM security.

    config EXAMPLE_USE_SC
        bool
        depends on BT_NIMBLE_SM_SC
        default n
        prompt "Use Secure Connection feature"
        help
            Use this option to enable/disable Security Manager Secure Connection 4.2 feature.

    config EXAMPLE_EXTENDED_ADV
        bool
        depends on SOC_BLE_50_SUPPORTED && BT_NIMBLE_50_FEATURE_SUPPORT
        default y if SOC_ESP_NIMBLE_CONTROLLER
        select BT_NIMBLE_EXT_ADV
        prompt "Enable Extended Adv"
        help
            Use this option to enable extended advertising in the example.
            If this option is disabled, ensure config BT_NIMBLE_EXT_ADV is
            also disabled from Nimble stack menuconfig

    config EXAMPLE_RANDOM_ADDR
        bool
        prompt "Advertise RANDOM Address"
        help
            Use this option to advertise a random address instead of public address

    config EXAMPLE_ENCRYPTION
        bool
        prompt "Enable Link Encryption"
        help
            This adds Encrypted Read and Write permissions in the custom GATT server.

    config EXAMPLE_RESOLVE_PEER_ADDR
        bool
        prompt "Enable resolving peer address"
        help
            Use this option to enable resolving peer's address.

endmenu

menu "Treadmill Configuration"

    config TREADMILL_IR_HEALTH_PERIOD_MS
        int "IR safety health-check period while treadmill is OFF (ms)"
        default 200
        range 50 10000
        help
            How often the VL53L0X array is health-checked / refreshed
            while the belt is OFF. 200 ms is the bench-tuning value
            (raw distances react in real time while choosing a sensor
            mount height); raise toward 2000 ms for normal use.
            Tune via menuconfig during threshold testing — no code
            change needed.

    config TREADMILL_VL53_DETECT_MAX_MM
        int "VL53L0X person-detection threshold (mm)"
        default 700
        range 100 2000
        help
            A sensor counts as detecting a person when a valid range
            reading is within this distance. 700 mm matches the
            side-rail cross-scan geometry (800x650 mm belt, far edge
            reads ~666 mm slant range). Still being tuned on the
            bench — change here instead of editing ir_safety.cpp.

    config TREADMILL_ZONE_CLEAN_MS
        int "Zone filter: time a safer zone must hold before adoption (ms)"
        default 500
        range 0 5000
        help
            Phase 1 item 1.1 (asymmetric zone filter): escalation to
            a more severe zone is instant, but de-escalation requires
            the safer zone to hold continuously for this long, so a
            single clean sample mid-danger does not restore speed.
            Time-based, not sweep-count-based: sweep duration changes
            ~30x once parallel ranging lands.

    config TREADMILL_ZONE_NONE_CONFIRM_MS
        int "Zone filter: time NONE must hold before it stops the belt (ms)"
        default 400
        range 0 5000
        help
            Phase 1 item 1.1: a single NONE (no person) sample must
            not stop the belt (gait, one bad sweep). NONE is adopted
            only after this long of continuous NONE; any real zone
            during the window cancels it.

    config TREADMILL_FAULT_BLIND_LATCH_SNAPSHOTS
        int "Sensor-fault latch: consecutive blind snapshots before latching"
        default 5
        range 1 50
        help
            Phase 1 item 1.1: a safety sensor blind for this many
            consecutive snapshots latches a fault. The latch stays
            set even if the sensor recovers, and ON is refused until
            a deliberate ON with healthy sensors acknowledges it.

    config TREADMILL_TASK_WDT_TIMEOUT_S
        int "Task watchdog timeout for safety tasks (seconds)"
        default 5
        range 1 60
        help
            Phase 1 item 1.3: safety_monitor and safety_key tasks must
            feed the task watchdog within this time or the chip resets
            (panic). Default 5 s, not 2 s: parallel ranging (item 1.2)
            dropped the normal monitor loop to ~105 ms, but a sensor
            recovery round (XSHUT 800 ms per sensor, several sensors)
            can legitimately exceed 2 s, and the watchdog is
            deliberately NOT fed during recovery — a recovery that
            never returns while the belt runs must reset the chip.
            Do not tighten below the worst-case recovery time.
            Software net only — the GĐ2 hardware ENA pull-down is
            what guarantees the motor stops even across a reset.

    config TREADMILL_VL53_BENCH_BUDGET_US
        int "VL53 timing budget while stopped/bench (microseconds)"
        default 200000
        range 20000 400000
        help
            Phase 1 item 1.2: per-sensor ranging budget in continuous
            mode while the belt is stopped. 200 ms is the old
            single-shot-era value, kept so raw-distance bench logging
            stays calm.

    config TREADMILL_VL53_RUNNING_BUDGET_US
        int "VL53 timing budget while running (microseconds)"
        default 50000
        range 20000 200000
        help
            Phase 1 item 1.2: per-sensor ranging budget in continuous
            mode while the belt moves. 50 ms keeps a full-array
            snapshot fresh enough for the 300 ms danger-to-stop
            target. Lower is faster but noisier; ST's usable floor
            is around 20 ms.

endmenu

menu "Treadmill Safety Key"

    config TREADMILL_SAFETY_KEY_GPIO
        int "Reed safety-key GPIO"
        default 23
        help
            GPIO reading the reed contact of the breakaway safety
            key. Contact to GND, internal pull-up used: magnet puck
            docked = contact closed = pin low.

    config TREADMILL_SAFETY_KEY_PRESENT_STABLE_MS
        int "Key-present confirm time (ms)"
        default 100
        range 10 2000
        help
            Contact must stay closed this long before the key counts
            as docked (slow to trust).

    config TREADMILL_SAFETY_KEY_ABSENT_CONFIRM_MS
        int "Key-lost confirm time (ms)"
        default 30
        range 5 500
        help
            Contact must stay open this long before a trip latches:
            long enough to reject contact bounce and vibration,
            short enough to stay inside the stop-latency budget
            (fast to trip).

endmenu

